# Copy to .env and fill in. .env is gitignored — never commit real values.

# GitHub personal access token (read-only, public repos).
# Optional: without it you get 60 API requests/hour instead of 5,000.
PATCHPILOT_GITHUB_TOKEN=

# Where cloned repositories are written. Relative paths resolve to the project root.
PATCHPILOT_WORKSPACE_DIR=workspace

# DEBUG | INFO | WARNING | ERROR
PATCHPILOT_LOG_LEVEL=INFO
