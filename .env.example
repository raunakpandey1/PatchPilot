# Copy to .env and fill in. .env is gitignored — never commit real values.

# GitHub personal access token (read-only, public repos).
# Optional: without it you get 60 API requests/hour instead of 5,000.
PATCHPILOT_GITHUB_TOKEN=

# Where cloned repositories are written. Relative paths resolve to the project root.
PATCHPILOT_WORKSPACE_DIR=workspace

# Google AI Studio key — free tier. https://aistudio.google.com/apikey
PATCHPILOT_GEMINI_API_KEY=

# Model IDs change; Google retires them. Check what your key can reach with
#   poetry run python scripts/list_models.py
PATCHPILOT_LLM_MODEL=gemini-3.8-flash
PATCHPILOT_LLM_MODEL_FAST=gemini-3.5-flash-lite

# DEBUG | INFO | WARNING | ERROR
PATCHPILOT_LOG_LEVEL=INFO
